#!/bin/bash
#SBATCH --job-name=edelweissfe_run
#SBATCH --mail-type=END,FAIL           # Mail events (NONE, BEGIN, END, FAIL, ALL)
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=64             # one full Ice Lake-SP node's *physical* cores;
                                        # LEO5 reports 128 (2x hyperthreaded) -- oversubscribing
                                        # HT for this compute-bound OpenMP code usually doesn't pay off,
                                        # benchmark on the 'test' partition before committing to a value.
#SBATCH --mem=240000mb
#SBATCH --time=1-00:00:00              # Wall time limit (days-hrs:min:sec)
#SBATCH -p std                         # default partition, max 10-00:00:00; use 'test' (max 10:00:00) for quick smoke runs
#SBATCH -o slurm-%j.out
#SBATCH -e slurm-%j.err
#SBATCH --mail-user=matthias.neuner@uibk.ac.at

# so a failing 'edelweissfe' still fails the job (and triggers --mail-type=FAIL)
# even though its exit status is piped through tee below
set -o pipefail

echo "Date              = $(date)"
echo "Hostname          = $(hostname -s)"
echo "Working Directory = $(pwd)"
echo ""
echo "Number of Nodes Allocated      = $SLURM_JOB_NUM_NODES"
echo "Number of Tasks Allocated      = $SLURM_NTASKS"
echo "Number of Cores/Task Allocated = $SLURM_CPUS_PER_TASK"

module load singularityce/4.3.0-python-3.11.9-gcc-13.3.0-n5qceek

export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK}
export SINGULARITYENV_OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK}
export APPTAINERENV_OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK}
# Never OMP_PROC_BIND/OMP_PLACES: they pin the Python element-loop workers to ONE core
# (see LEO5_RUNBOOK.md, "Threading"). Explicitly false so nothing inherited can enable it.
export OMP_PROC_BIND=false
export SINGULARITYENV_OMP_PROC_BIND=false
export APPTAINERENV_OMP_PROC_BIND=false
export SINGULARITYENV_PYTHON_GIL=0
export APPTAINERENV_PYTHON_GIL=0
# Python fully buffers stdout when it's not a TTY (e.g. redirected to a log
# file) -- without this, the log file stays empty for long stretches and
# only catches up in bursts, or not at all if the job is killed/times out.
export PYTHONUNBUFFERED=1
export SINGULARITYENV_PYTHONUNBUFFERED=1
export APPTAINERENV_PYTHONUNBUFFERED=1

# LEO5's Singularity install only auto-binds $HOME, not $SCRATCH -- bind the
# working directory explicitly or the container won't see your input files.
# $1: path to the .inp input file, relative to the current working directory
# Log written explicitly to $1.log in addition to Slurm's own -o/-e (which
# land in slurm-<jobid>.out/.err) -- tail -f $1.log to follow.
singularity exec --bind "$(pwd)" edelweissfe-debian-13.sif edelweissfe "$1" 2>&1 | tee "${1%.inp}.log"
